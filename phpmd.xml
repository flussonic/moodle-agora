<?xml version="1.0"?>
<ruleset name="PHPMD rules for mod_agora"
        xmlns="http://pmd.sf.net/ruleset/1.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
        xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">

    <description>
        The moodle-plugin-ci rule set, with one documented exception:
        test classes legitimately grow past the method-count limits — each
        public method is a test case. TooManyMethods and TooManyPublicMethods
        do not apply to tests/.
    </description>

    <rule ref="rulesets/codesize.xml">
        <exclude name="TooManyMethods"/>
        <exclude name="TooManyPublicMethods"/>
    </rule>
    <rule ref="rulesets/codesize.xml/TooManyMethods">
        <exclude-pattern>*tests/*</exclude-pattern>
    </rule>
    <rule ref="rulesets/codesize.xml/TooManyPublicMethods">
        <exclude-pattern>*tests/*</exclude-pattern>
    </rule>
    <rule ref="rulesets/unusedcode.xml"/>
    <rule ref="rulesets/naming.xml">
        <!-- This rule throws out a problem on var names less than three chars, Moodle has $DB, $rs, etc -->
        <exclude name="ShortVariable"/>
    </rule>
    <rule ref="rulesets/design.xml"/>
    <rule ref="rulesets/cleancode.xml/BooleanArgumentFlag"/>

</ruleset>
