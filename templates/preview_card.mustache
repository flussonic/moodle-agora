{{!
    @template mod_agora/preview_card

    Broadcast frame card with a state badge: the same one in the course page
    list and in the sidebar of the element page.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * haslink boolean — the card is a link
    * link string — URL of the element page
    * cardclass string — card classes: size and the "no frame" flag
    * decorative boolean — remove the card from focus and from screen readers
    * hasimage boolean — frame exists
    * image string — frame URL
    * locked boolean — element closed by a restriction: a lock instead of the
      frame
    * hasbadge boolean — state is known
    * badge string — state name
    * badgeclass string — badge color class
    * srbadge boolean — duplicate the state as a string for screen readers

    Example context (json):
    {
        "haslink": true,
        "link": "https://moodle.example.com/mod/agora/view.php?id=42",
        "cardclass": "mod-agora-preview-card mod-agora-preview-side",
        "decorative": false,
        "hasimage": true,
        "image": "https://moodle.example.com/pluginfile.php/12/mod_agora/preview/0/cached/preview.jpg",
        "locked": false,
        "hasbadge": true,
        "badge": "Live",
        "badgeclass": "mod-agora-state-badge-live",
        "srbadge": true
    }
}}
{{#haslink}}
<a href="{{link}}" class="{{cardclass}}" {{#decorative}}aria-hidden="true" tabindex="-1"{{/decorative}}>
    {{#hasimage}}
        <img src="{{image}}" alt="" class="mod-agora-preview" loading="lazy">
    {{/hasimage}}
    {{^hasimage}}
        {{#locked}}{{#pix}}i/lock, core{{/pix}}{{/locked}}
        {{^locked}}{{#pix}}monologo, mod_agora{{/pix}}{{/locked}}
    {{/hasimage}}
    {{#hasbadge}}
        <span class="mod-agora-state-badge {{badgeclass}}" {{#srbadge}}aria-hidden="true"{{/srbadge}}>{{badge}}</span>
    {{/hasbadge}}
    {{#srbadge}}<span class="sr-only">{{badge}}</span>{{/srbadge}}
</a>
{{/haslink}}
{{^haslink}}
<span class="{{cardclass}}" {{#decorative}}aria-hidden="true"{{/decorative}}>
    {{#hasimage}}
        <img src="{{image}}" alt="" class="mod-agora-preview" loading="lazy">
    {{/hasimage}}
    {{^hasimage}}
        {{#locked}}{{#pix}}i/lock, core{{/pix}}{{/locked}}
        {{^locked}}{{#pix}}monologo, mod_agora{{/pix}}{{/locked}}
    {{/hasimage}}
    {{#hasbadge}}
        <span class="mod-agora-state-badge {{badgeclass}}" {{#srbadge}}aria-hidden="true"{{/srbadge}}>{{badge}}</span>
    {{/hasbadge}}
    {{#srbadge}}<span class="sr-only">{{badge}}</span>{{/srbadge}}
</span>
{{/haslink}}
